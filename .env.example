# Where the Next.js server forwards /api requests (the FastAPI app).
# Read when the server starts (and at build time for `next build`).
API_TARGET=https://market-analysis.pflabs.in
# For a local API instead: API_TARGET=http://127.0.0.1:8001

# Optional: call the API directly from the browser instead of through /api.
# Needs CORS enabled on the FastAPI app.
# NEXT_PUBLIC_API_BASE_URL=https://your-api.example.com
